<UserControl x:Class="RLC_LoadBank.Views.Controls.RlcDiagramStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="1080">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#F8FAFB" />
            <Setter Property="BorderBrush" Value="#DCE4EA" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="12,8"
                Background="#E9F6F7"
                CornerRadius="12">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource CardHeaderBrush}"
                       Text="RLC Diagram / MC Status" />
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#00B26F" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="#344054" Text="ON" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="White" Stroke="#98A2B3" StrokeThickness="2" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="#344054" Text="OFF" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#F3F5F7" Stroke="#D0D7DE" StrokeThickness="2" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="#344054" Text="COMM WAIT" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Padding="12,7"
                    Background="#F8FAFB"
                    BorderBrush="#DCE4EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#61758A"
                           Text="{Binding McSummaryText}" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,18,12,18"
                    Padding="12"
                    Background="#FBFCFD"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#344054"
                                   Text="AC SOURCE" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#61758A"
                                   Text="3P4W / 380V / 60Hz" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="10,6"
                            HorizontalAlignment="Center"
                            Background="#E8F7F0"
                            BorderBrush="#B7E7D0"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#00B26F"
                                   Text="MCCB1 ON" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.RowSpan="2" Margin="78,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="453" />
                        <ColumnDefinition Width="385" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FBFCFD" BorderBrush="#E24A3B" BorderThickness="1" CornerRadius="16" Margin="70,0,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#E24A3B"
                                   Text="R (Resistance)" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FBFCFD" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="16" Margin="5,0,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"
                                   Text="L (Reactor)" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    </Border>
                    
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding LineDiagramRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Height="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="-11,0,5,15"
                                        Background="Black"
                                        VerticalAlignment="Center" />
                                <Border Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="2" Style="{StaticResource BadgeBorderStyle}" Margin="15,0,30,15">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#344054"
                                                       Margin="5,0,0,0"
                                                       Text="{Binding PhaseLabel}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#61758A"
                                                       Margin="10,0,0,1"
                                                       Text="{Binding SummaryText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>


                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Border Height="2"
                                            Margin="12,0,0,15"
                                            Background="#DCE4EA"
                                            VerticalAlignment="Center" />

                                    <Canvas Width="72"
                                            Height="20"
                                            Margin="0,0,-30,15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <Line X1="0"
                                              Y1="10"
                                              X2="52"
                                              Y2="10"
                                              Stroke="#AFC0D5"
                                              StrokeThickness="2" />
                                        <Line X1="51"
                                              Y1="{Binding VerY1}"
                                              X2="51"
                                              Y2="{Binding VerY2}"
                                              Stroke="#61758A"
                                              StrokeThickness="1.6" />
                                        <Line X1="{Binding ConnX1}"
                                              Y1="50"
                                              X2="{Binding ConnX2}"
                                              Y2="50"
                                              Stroke="#61758A"
                                              StrokeThickness="1.6" />
                                        <Ellipse Fill="Black"
                                                 Stroke="{Binding RingBrush}"
                                                 StrokeThickness="2.5" 
                                                 Width="5" Height="5"
                                                 Canvas.Left="49" Canvas.Top="48"
                                                 Visibility="{Binding VisibleEllipse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Canvas>

                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding ToolTipText}">
                                                    <Grid Width="34" Height="34" HorizontalAlignment="Center">
                                                        <Ellipse Fill="{Binding FillBrush}"
                                                                 Stroke="{Binding RingBrush}"
                                                                 StrokeThickness="2.5" />
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding LabelBrush}"
                                                                   Text="{Binding Label}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,3,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="9"
                                                               Foreground="#61758A"
                                                               Text="{Binding Address}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding ToolTipText}">
                                                    <Grid Width="34" Height="34" HorizontalAlignment="Center">
                                                        <Ellipse Fill="{Binding FillBrush}"
                                                                 Stroke="{Binding RingBrush}"
                                                                 StrokeThickness="2.5" />
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding LabelBrush}"
                                                                   Text="{Binding Label}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,3,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="9"
                                                               Foreground="#61758A"
                                                               Text="{Binding Address}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Column="2"
                    Margin="25,0,0,10"
                    Padding="14"
                    Background="#FBFCFD"
                    BorderBrush="#3182F6"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#3182F6"
                               Text="C (Capacitor)" />

                    <Grid Grid.Row="1"
                          Margin="0,10,0,0"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Width="92"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#61758A"
                                       Text="1" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#61758A"
                                       Text="2" />
                        </Grid>

                        <Grid Grid.Row="1"
                              Width="128"
                              Height="48"
                              HorizontalAlignment="Center">
                            <Border Height="2"
                                    Background="#AFC0D5"
                                    VerticalAlignment="Center" />

                            <Grid Margin="22,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="34"
                                      Height="34"
                                      HorizontalAlignment="Center"
                                      ToolTip="{Binding CapacitorNodes[0].ToolTipText}">
                                    <Ellipse Fill="{Binding CapacitorNodes[0].FillBrush}"
                                             Stroke="{Binding CapacitorNodes[0].RingBrush}"
                                             StrokeThickness="2.5" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{Binding CapacitorNodes[0].LabelBrush}"
                                               Text="{Binding CapacitorNodes[0].Label}" />
                                </Grid>

                                <Grid Grid.Column="1"
                                      Width="34"
                                      Height="34"
                                      HorizontalAlignment="Center"
                                      ToolTip="{Binding CapacitorNodes[1].ToolTipText}">
                                    <Ellipse Fill="{Binding CapacitorNodes[1].FillBrush}"
                                             Stroke="{Binding CapacitorNodes[1].RingBrush}"
                                             StrokeThickness="2.5" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{Binding CapacitorNodes[1].LabelBrush}"
                                               Text="{Binding CapacitorNodes[1].Label}" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2"
                              Width="92"
                              Margin="0,2,0,0"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#61758A"
                                       Text="{Binding CapacitorNodes[0].Label}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#61758A"
                                       Text="{Binding CapacitorNodes[1].Label}" />
                        </Grid>

                        <Grid Grid.Row="3"
                              Width="92"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="20"
                                  Height="28"
                                  HorizontalAlignment="Center">
                                <Line X1="10" Y1="0" X2="10" Y2="7" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="2" Y1="16" X2="18" Y2="16" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="10" Y1="18" X2="10" Y2="28" Stroke="#61758A" StrokeThickness="1.6" />
                            </Grid>

                            <Grid Grid.Column="1"
                                  Width="20"
                                  Height="28"
                                  HorizontalAlignment="Center">
                                <Line X1="10" Y1="0" X2="10" Y2="7" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="2" Y1="16" X2="18" Y2="16" Stroke="#61758A" StrokeThickness="1.6" />
                                <Line X1="10" Y1="18" X2="10" Y2="28" Stroke="#61758A" StrokeThickness="1.6" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#61758A"
                               Text="DI 48 ~ 49" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#61758A"
                       Text="{Binding McCommunicationText}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#344054"
                       Text="{Binding McLastUpdateText}" />
        </Grid>
    </Grid>
</UserControl>
