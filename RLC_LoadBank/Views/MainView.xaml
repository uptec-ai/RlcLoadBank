<UserControl
    x:Class="RLC_LoadBank.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:ViewModels="clr-namespace:RLC_LoadBank.ViewModels" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    mc:Ignorable="d"
    d:DesignHeight="1080"
    d:DesignWidth="1920">
    <UserControl.DataContext>
        <ViewModels:MainViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="DashboardBackgroundBrush" Color="#F4F7F9" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D9E2E8" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="CardHeaderBrush" Color="#0F8B94" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F8FBFC" />
        <SolidColorBrush x:Key="OutlineBrush" Color="#FFB5BABD" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E6D" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F08C00" />

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="{StaticResource CardHeaderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="#EDF2F5" />
        </Style>

        <Style x:Key="OutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <Grid Height="1040"
            Margin="18"
            MinWidth="1580"
            Background="{StaticResource DashboardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="115" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource PanelCardStyle}"
                    Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="PLC 통신" />
                    <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Ellipse
                                Width="14"
                                Height="14"
                                Fill="{Binding PlcStatusBrush}" />
                        <TextBlock
                                Margin="10,0,0,0"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="{Binding PlcStatusText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="모드" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                                Grid.Column="0"
                                Padding="12,10"
                                Background="#E7F7F2"
                                BorderBrush="#BFE7D6"
                                BorderThickness="1"
                                CornerRadius="12,0,0,12">
                            <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Text="자동모드" />
                        </Border>
                        <Border
                                Grid.Column="1"
                                Padding="12,10"
                                Background="#F3F5F7"
                                BorderBrush="#D0D5DD"
                                BorderThickness="1"
                                CornerRadius="0,12,12,0">
                            <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="수동모드" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                    <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="상태" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding StateBadges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                        Margin="0,0,10,0"
                                        Padding="10,8"
                                        Background="{Binding BackgroundBrush}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                                Width="10"
                                                Height="10"
                                                VerticalAlignment="Center"
                                                Fill="{Binding IndicatorBrush}" />
                                        <TextBlock
                                                Margin="8,0,6,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BodyTextBrush}"
                                                Text="{Binding Label}" />
                                        <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{Binding Value}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="날짜/시간" />
                    <Border
                            Margin="0,10,0,0"
                            Padding="14,12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BodyTextBrush}"
                                Text="{Binding CurrentDateTimeText}"
                                TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                            Margin="0,0,0,16"
                            Padding="12,8"
                            Background="{StaticResource CardHeaderBrush}"
                            CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource PanelTitleStyle}"
                                   Text="3상 제어 현황" />
                </Border>

                <ItemsControl ItemsSource="{Binding ThreePhaseItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,15"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{Binding AccentBrush}" CornerRadius="14,0,0,14" />

                                    <Grid Grid.Column="1" Height="130" Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding AccentBrush}"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Top" Margin="0,-5,0,0" />
                                        <TextBlock Grid.Column="1"
                                                       Margin="5,8,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BodyTextBrush}"
                                                       Text="{Binding Description}" />
                                        <Border Grid.Column="2"
                                                    Padding="10,6"
                                                    Background="White"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                            <TextBlock
                                                    FontSize="12"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding StepText}" />
                                        </Border>

                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Margin="0,0,8,0"
                                                        Height="75"
                                                        Padding="12,10"
                                                        Background="White"
                                                        BorderBrush="{StaticResource OutlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="목표 용량" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:TextEdit Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                                                                         FontSize="28"
                                                                         FontWeight="Bold"
                                                                         BorderBrush="Transparent"
                                                                         Foreground="{StaticResource BodyTextBrush}" Margin="30,0,0,0" CaretBrush="{x:Null}">
                                                        </dx:TextEdit>
                                                        <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="20,0,0,5"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Height="75"
                                                        Padding="12,10"
                                                        Background="White"
                                                        BorderBrush="{StaticResource OutlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="실제 투입" />
                                                    <TextBlock FontSize="28"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource BodyTextBrush}">
                                                            <Run Text="{Binding ActualValue, StringFormat={}{0:F1}}" />
                                                            <Run Text=" " />
                                                            <Run FontSize="14" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Unit}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="사용률" Margin="5,0,0,0" />
                                                <ProgressBar Height="10"
                                                                 Maximum="100"
                                                                 Value="{Binding UsagePercent}" Margin="10,0,0,0" Width="360"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BodyTextBrush}"
                                                               Text="{Binding UsagePercent, StringFormat={}{0:F1}%}" />
                                            </DockPanel>

                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        Background="{StaticResource CardHeaderBrush}"
                        CornerRadius="12">
                    <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource PanelTitleStyle}"
                            Text="자동 모드 설정 및 운전 현황" />
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="목표 운전 설정" />
                            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding AutoTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding AccentBrush}"
                                                    Text="{Binding Label}"
                                                    VerticalAlignment="Center" />
                                            <TextBox
                                                    Grid.Column="1"
                                                    Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                    Text="{Binding Value}" />
                                            <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding Unit}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="실제 투입 현황" />
                            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding AutoModeActuals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding AccentBrush}"
                                                    Text="{Binding Label}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    FontSize="30"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BodyTextBrush}"
                                                    Text="{Binding Value}" />
                                            <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding Unit}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="조합 결과 요약" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="구분" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="목표용량" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="실제투입" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="오차" />
                                <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="사용률" />
                            </Grid>

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AutoModeSummaryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="0.7*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Foreground="{StaticResource BodyTextBrush}" Text="{Binding Category}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource BodyTextBrush}" Text="{Binding TargetValue, StringFormat={}{0:F1}}" />
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource BodyTextBrush}" Text="{Binding ActualValue, StringFormat={}{0:F1}}" />
                                            <TextBlock Grid.Column="3" Foreground="{StaticResource BodyTextBrush}" Text="{Binding ErrorValue, StringFormat={}{0:F1}}" />
                                            <TextBlock Grid.Column="4" Foreground="{StaticResource BodyTextBrush}" Text="{Binding UsageText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="{StaticResource CardHeaderBrush}"
                                Content="자동 운전 시작"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="기능 구현 예정" />
                        <Button
                                Grid.Column="1"
                                Margin="8,0"
                                Background="#D92D20"
                                Content="자동 운전 정지"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="기능 구현 예정" />
                        <Button
                                Grid.Column="2"
                                Margin="8,0"
                                Content="초기화"
                                IsEnabled="False"
                                Style="{StaticResource OutlinedButtonStyle}"
                                ToolTip="기능 구현 예정" />
                        <Button
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                Content="자동설정 조건"
                                IsEnabled="False"
                                Style="{StaticResource OutlinedButtonStyle}"
                                ToolTip="기능 구현 예정" />
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        Background="{StaticResource CardHeaderBrush}"
                        CornerRadius="12">
                    <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource PanelTitleStyle}"
                            Text="수동 모드 스텝 제어" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BodyTextBrush}"
                            Text="수동 투입/차단 스텝 패널은 다음 단계에서 구현합니다."
                            TextWrapping="Wrap" />
                    <TextBlock
                            Margin="0,10,0,0"
                            FontSize="13"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="현재는 3행 3열 메인 대시보드 구조와 상단 핵심 카드 영역만 우선 배치했습니다."
                            TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,12,0"
                Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,14"
                        Padding="12,8"
                        Background="#E9F6F7"
                        CornerRadius="12">
                    <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource CardHeaderBrush}"
                            Text="선로 구성도 / MC 투입 현황" />
                </Border>
                <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="결선도, 실시간 MC 상태, 계측값 영역 예정" />
            </DockPanel>
        </Border>

        <Border
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,12,0"
                Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,14"
                        Padding="12,8"
                        Background="#FFF6E8"
                        CornerRadius="12">
                    <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WarningBrush}"
                            Text="경보 현황" />
                </Border>
                <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="트립, 고온, 통신 이상 등 경보 목록 영역 예정" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,14"
                        Padding="12,8"
                        Background="#FDECEC"
                        CornerRadius="12">
                    <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DangerBrush}"
                            Text="트립 / 운전 이력" />
                </Border>
                <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="운전 이벤트 로그, 정지 이력, 알람 이력 영역 예정" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
