<UserControl
    x:Class="RLC_LoadBank.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:ViewModels="clr-namespace:RLC_LoadBank.ViewModels" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:Controls="clr-namespace:RLC_LoadBank.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    FontFamily="Noto Sans KR">
    <UserControl.DataContext>
        <ViewModels:MainViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,14" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="{StaticResource CardHeaderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="#EDF2F5" />
        </Style>

        <Style x:Key="OutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="1180"
              Margin="18"
              MinWidth="1580"
              Background="{StaticResource DashboardBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="700" />
                <RowDefinition Height="400" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource PanelCardStyle}"
                Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                        Padding="0"
                        Margin="5,0"
                        BorderBrush="#FFD9E2E8"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Grid.Column="1" Margin="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <TextBlock Margin="20,-3,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="PLC 통신" FontFamily="Noto Sans KR" 
                                   VerticalAlignment="Center" />
                            <Ellipse Width="10"
                                 Height="10"
                                 Fill="#FF00C36D" 
                                 Margin="10,0,0,0" />
                            <TextBlock Margin="10,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="#FF00C36D"
                                   Text="{Binding PlcStatusText}" FontFamily="Noto Sans KR" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                        Padding="0"
                        Margin="5,0"
                        BorderBrush="#FFD9E2E8"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Margin="20,-3,0,0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="운전 모드" FontFamily="Noto Sans KR" VerticalAlignment="Center" />
                            <Grid Margin="10,0,0,0" Width="172" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Padding="0,5,0,0"
                                        Background="#E7F7F2"
                                        BorderBrush="#BFE7D6"
                                        BorderThickness="1"
                                        CornerRadius="6,0,0,6">
                                    <TextBlock HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="자동모드" />
                                </Border>
                                <Border Grid.Column="1"
                                        Padding="0,5,0,0"
                                        Background="#F3F5F7"
                                        BorderBrush="#D0D5DD"
                                        BorderThickness="1"
                                        CornerRadius="0,6,6,0">
                                    <TextBlock HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="수동모드" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"                         
                        Padding="0"
                        Margin="5,0"
                        BorderBrush="#FFD9E2E8"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Margin="20,-3,0,0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="상태" FontFamily="Noto Sans KR" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding StateBadges}" Margin="10,5,0,5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,0"
                                                Padding="10,5"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10"
                                                     Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding IndicatorBrush}" />
                                                <TextBlock Margin="8,0,6,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BodyTextBrush}"
                                                       Text="{Binding Label}" />
                                                <TextBlock FontSize="13"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Value, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" 
                        Padding="0"
                        Margin="5,0"
                        BorderBrush="#FFD9E2E8"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Margin="20,0,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="날짜/시간" FontFamily="Noto Sans KR" VerticalAlignment="Center" />
                            <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BodyTextBrush}"
                                   Text="{Binding StatusManager.CurrentTime, Source={x:Static Application.Current}}"
                                   TextAlignment="Center" Margin="10,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,10"
                            Padding="12,8"
                            Background="{StaticResource CardHeaderBrush}"
                            CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource PanelTitleStyle}"
                                   Text="3상 제어 현황" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ThreePhaseItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{Binding AccentBrush}" CornerRadius="14,0,0,14" />

                                        <Grid Grid.Column="1" Height="120" Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="20" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Top" Margin="0,-5,0,0" />
                                            <TextBlock Grid.Column="1"
                                                   Margin="5,8,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BodyTextBrush}"
                                                   Text="{Binding Description}" />
                                            <Border Grid.Column="2"
                                                Padding="10,6"
                                                Background="White"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <TextBlock FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding StepText}" />
                                            </Border>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Margin="0,0,8,0"
                                                    Height="50"
                                                    Background="White"
                                                    BorderBrush="{StaticResource OutlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                                        <TextBlock FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="목표 용량"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <dx:TextEdit Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                                                                     FontSize="26"
                                                                     FontWeight="Bold"
                                                                     BorderBrush="Transparent"
                                                                     Foreground="{StaticResource BodyTextBrush}" Margin="15,0,0,0"/>
                                                            <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0,0,0,7" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,8,0"
                                                    Height="50"
                                                    Grid.Column="1"
                                                    Background="White"
                                                    BorderBrush="{StaticResource OutlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                                        <TextBlock FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="실제 투입" />
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <dx:TextEdit Text="{Binding ActualValue, StringFormat={}{0:F1}}" 
                                                                     FontSize="26"
                                                                     FontWeight="Bold"
                                                                     BorderBrush="Transparent"
                                                                     Foreground="{StaticResource BodyTextBrush}" Margin="15,0,0,0"/>
                                                            <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0,0,0,7" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="사용률" Margin="5,0,0,0" />
                                                    <ProgressBar Height="10"
                                                             Maximum="100"
                                                             Value="{Binding UsagePercent, Mode=OneWay}" Margin="10,0,0,0" Width="330"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BodyTextBrush}"
                                                           Text="{Binding UsagePercent, StringFormat={}{0:F1}%}" />
                                                </DockPanel>

                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <Border
                        DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        Background="{StaticResource CardHeaderBrush}"
                        CornerRadius="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource PanelTitleStyle}"
                            Text="자동 모드 설정 및 운전 현황" />
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="목표 운전 설정" />
                                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding AutoTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding AccentBrush}"
                                                    Text="{Binding Label}"
                                                    VerticalAlignment="Center" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                    Text="{Binding Value, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="실제 투입 현황" />
                                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding AutoModeActuals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding AccentBrush}"
                                                    Text="{Binding Label}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    FontSize="30"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BodyTextBrush}"
                                                    Text="{Binding Value}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BodyTextBrush}"
                                    Text="조합 결과 요약" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.7*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="구분" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="목표용량" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="실제투입" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="오차" />
                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="사용률" />
                                </Grid>

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AutoModeSummaryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Foreground="{StaticResource BodyTextBrush}" Text="{Binding Category}" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource BodyTextBrush}" Text="{Binding TargetValue, StringFormat={}{0:F1}}" />
                                                <TextBlock Grid.Column="2" Foreground="{StaticResource BodyTextBrush}" Text="{Binding ActualValue, StringFormat={}{0:F1}}" />
                                                <TextBlock Grid.Column="3" Foreground="{StaticResource BodyTextBrush}" Text="{Binding ErrorValue, StringFormat={}{0:F1}}" />
                                                <TextBlock Grid.Column="4" Foreground="{StaticResource BodyTextBrush}" Text="{Binding UsageText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="{StaticResource CardHeaderBrush}"
                                Content="자동 운전 시작"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="기능 구현 예정" />
                            <Button
                                Grid.Column="1"
                                Margin="8,0"
                                Background="#D92D20"
                                Content="자동 운전 정지"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="기능 구현 예정" />
                            <Button
                                Grid.Column="2"
                                Margin="8,0"
                                Content="초기화"
                                IsEnabled="False"
                                Style="{StaticResource OutlinedButtonStyle}"
                                ToolTip="기능 구현 예정" />
                            <Button
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                Content="자동설정 조건"
                                IsEnabled="False"
                                Style="{StaticResource OutlinedButtonStyle}"
                                ToolTip="기능 구현 예정" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        Background="{StaticResource CardHeaderBrush}"
                        CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource PanelTitleStyle}"
                               Text="수동 모드 스텝 제어" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BodyTextBrush}"
                               Text="수동 투입/차단 스텝 패널은 다음 단계에서 구현합니다."
                               TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="현재는 3행 3열 메인 대시보드 구조와 상단 핵심 카드 영역만 우선 배치했습니다."
                               TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
